# ── RENEE B2B web app — environment config ──────────────────────────────────
# Copy this file to  .env  (same folder as manage.py) and fill in REAL values.
#   .env is gitignored — never commit it.
# python-dotenv loads .env automatically at startup (see renee_cosmetics/settings.py).
# On PythonAnywhere you can keep this .env OR set the same vars in the WSGI file.

# ── Django ──
# Generate a fresh key:  python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=USERNAME.pythonanywhere.com
# HTTPS hosts REQUIRE the origin with scheme, or POST forms 403. Comma-separated.
DJANGO_CSRF_TRUSTED_ORIGINS=https://USERNAME.pythonanywhere.com
# HTTPS hardening: set to 1 on an SSL host (PythonAnywhere) — enables secure
# cookies + HTTP→HTTPS redirect. Leave blank/0 for plain-HTTP LAN/dev.
DJANGO_SECURE_SSL=1
# Optional HSTS (seconds; 0 = off). Careful on shared *.pythonanywhere.com.
DJANGO_HSTS_SECONDS=0

# ── Business DB (MySQL renee_orders) ──
# Absolute path to the JSON holding the MySQL creds (see db_config.example.json).
ONLINE_PO_DB_CONFIG=/home/USERNAME/db_config.json

# ── Email (Gmail SMTP) — PO report emails ──
# Use a Gmail *App Password* (16 chars), NOT the account password.
# ⚠ Rotate the old one first — it was previously committed (see PYTHONANYWHERE.md).
EMAIL_SENDER=youraccount@gmail.com
EMAIL_PASSWORD=your gmail app password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_DEFAULT_RECIPIENT=abhishek.wagh@reneecosmetics.in
